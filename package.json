{
  "name": "@molesignal/browser-rum",
  "version": "0.1.0-alpha.1",
  "description": "MoleSignal browser real user monitoring SDK",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:js && npm run build:types",
    "build:js": "tsup --config tsup.config.mjs",
    "build:types": "tsc --emitDeclarationOnly --declaration --noEmit false --outDir dist",
    "test": "npm run build && npm run test:unit && npm run test:types",
    "test:unit": "node --test test/public-api.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:types": "tsc --ignoreConfig --noEmit --strict --skipLibCheck false --target ES2020 --module NodeNext --moduleResolution NodeNext --lib ES2020,DOM test/fixtures/consumer.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "molesignal",
    "rum",
    "real-user-monitoring",
    "observability",
    "web-vitals",
    "session-replay"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molesignal/browser-rum.git"
  },
  "bugs": {
    "url": "https://github.com/molesignal/browser-rum/issues"
  },
  "homepage": "https://github.com/molesignal/browser-rum#readme",
  "author": {
    "name": "MoleSignal",
    "email": "opensource@molesignal.io"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@rrweb/record": "^2.1.1",
    "web-vitals": "6.0.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
