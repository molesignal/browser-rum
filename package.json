{
  "name": "@molesignal/browser-rum",
  "version": "0.5.0",
  "description": "MoleSignal browser real user monitoring SDK",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/molesignal-rum.js",
  "jsdelivr": "./dist/molesignal-rum.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./molesignal-rum.js": "./dist/molesignal-rum.js",
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:js && npm run build:types",
    "build:js": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup --config tsup.config.mjs",
    "build:types": "tsc --emitDeclarationOnly --declaration --noEmit false --outDir dist",
    "test": "npm run build && npm run test:unit && npm run test:types",
    "test:unit": "node --experimental-test-module-mocks --disable-warning=ExperimentalWarning --test --test-force-exit test/public-api.test.mjs test/views.test.mjs test/sessions.test.mjs test/global-api.test.mjs test/early-consent.test.mjs test/replay.test.mjs test/contract.test.mjs test/logs.test.mjs test/testing-context.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:types": "tsc --ignoreConfig --noEmit --strict --skipLibCheck false --target ES2020 --module NodeNext --moduleResolution NodeNext --lib ES2020,DOM test/fixtures/consumer.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "molesignal",
    "rum",
    "real-user-monitoring",
    "observability",
    "web-vitals",
    "session-replay"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molesignal/browser-rum.git"
  },
  "bugs": {
    "url": "https://github.com/molesignal/browser-rum/issues"
  },
  "homepage": "https://github.com/molesignal/browser-rum#readme",
  "author": {
    "name": "MoleSignal",
    "email": "opensource@molesignal.io"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.12",
    "ajv": "^8.20.0",
    "react": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@rrweb/record": "^2.1.1",
    "web-vitals": "6.0.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
